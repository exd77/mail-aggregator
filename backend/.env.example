# ===== Mail Aggregator Backend =====

# Server
PORT=8787

# JWT secret (generate a random string, min 32 chars)
JWT_SECRET=change_me_to_random_string_here

# Dashboard admin credentials
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# Master encryption key for refresh tokens (32+ chars)
ENCRYPTION_KEY=change_me_to_random_string_here

# ===== Gmail OAuth =====
# Get these from Google Cloud Console > APIs > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth callback port (must match redirect_uri in Google Cloud Console)
OAUTH_CALLBACK_PORT=8788

# Public base URL (leave empty for local, set for remote server)
PUBLIC_BASE_URL=
